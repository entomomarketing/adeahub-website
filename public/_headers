# Response headers for Cloudflare (Workers static assets read this file; it is not served as a page).
# HTML keeps Cloudflare's default (revalidate on every visit), so a release shows up immediately.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# site.css, base.css and site.js are linked with a ?v=<content hash>, so a changed file gets a new URL
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# rename an image or download to replace it before the 30 days are up
/assets/images/*
  Cache-Control: public, max-age=2592000
/assets/downloads/*
  Cache-Control: public, max-age=2592000
