# Response headers for Cloudflare (Workers static assets read this file; it is not served as a page).
# Same baseline as the entomo website. tools/build.py checks that every header below is present and that no line
# passes Cloudflare's 2,000-character limit. HTML keeps Cloudflare's default (revalidate on every visit).
#
# The Content-Security-Policy is sent as Report-Only first: browsers report violations to /api/csp-report (the Worker
# logs them; Workers Logs, filter "csp-report") without blocking anything. After about a week of clean reports on
# production, rename the header to Content-Security-Policy. script-src keeps 'unsafe-inline' on purpose: every page
# carries inline scripts (JSON-LD, the tag loader, page behaviour). Allowed outside hosts: Cloudflare Turnstile and
# the Google Tag Manager container with what it loads (GA4, Google Ads). See docs/FORMS-AND-SECURITY.md.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://*.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.googleadservices.com; frame-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com https://*.doubleclick.net https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report

# site.css, base.css, site.js and forms.js are linked with a ?v=<content hash>, so a changed file gets a new URL
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# rename an image or download to replace it before the 30 days are up
/assets/images/*
  Cache-Control: public, max-age=2592000
/assets/downloads/*
  Cache-Control: public, max-age=2592000
